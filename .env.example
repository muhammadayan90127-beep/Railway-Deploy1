# =============================================
# M.H. INTERIOR DESIGN — Environment Variables
# =============================================
# Copy these to Railway → Service → Variables tab
# =============================================

# PostgreSQL Database (Railway: use ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:port/dbname

# Node environment (must be "production" on Railway)
NODE_ENV=production

# JWT secret key — any random string (keep it secret!)
SESSION_SECRET=mhinterior-secret-key-2025

# Admin panel password — to access /admin page
ADMIN_PASSWORD=mhinterior2025

# Node.js version for Railway Nixpacks build
NIXPACKS_NODE_VERSION=22

# (Optional) Resend API key — for sending emails
# Get free key from: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
